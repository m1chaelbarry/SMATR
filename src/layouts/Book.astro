---
import { getCollection } from 'astro:content';
import { parts, url } from '../lib/links';
import '../styles/book.css';
import 'katex/dist/katex.min.css';
const { title = 'Podręcznik SMATR', description = 'Przygotowanie do laboratoriów sterowania zespołem posuwowym JBD-320.', active = '', wide = false } = Astro.props;
const lessons = (await getCollection('lessons')).sort((a,b) => a.data.order-b.data.order);
---
<!doctype html>
<html lang="pl">
<head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#172033"/><title>{title} · SMATR</title><link rel="icon" href={url('favicon.svg')} type="image/svg+xml"/></head>
<body>
<a class="skip" href="#tresc">Przejdź do treści</a>
<header class="topbar"><a class="brand" href={url()} aria-label="SMATR — strona startowa"><span class="brand-symbol">S</span>SMATR<span class="brand-sub">laboratorium sterowania</span></a><nav aria-label="Główna nawigacja">{parts.map(p=><a href={url(`${p.id}/`)} aria-current={active===p.id?'page':undefined}>{p.label}</a>)}<a href={url('trening/')} aria-current={active==='trening'?'page':undefined}>Trening</a><a href={url('powtorka/')} aria-current={active==='powtorka'?'page':undefined}>Powtórka</a></nav></header>
<div class:list={['book-shell', {wide}]}>
<aside class="sidebar"><details class="toc" open><summary>Spis podręcznika</summary><div class="toc-content">{parts.map(p=><section><a class="part-title" href={url(`${p.id}/`)}><span style={`color:${p.color}`}>{p.mark}</span>{p.label}</a>{lessons.filter(l=>l.data.part===p.id).map(l=><a class="lesson-link" href={url(`${p.id}/${l.id}/`)} aria-current={Astro.url.pathname.endsWith(`/${l.id}/`)?'page':undefined}>{l.data.title}</a>)}</section>)}<div class="toc-extra"><a href={url('slownik/')}>Słownik oznaczeń</a><a href={url('zrodla/')}>Źródła i korekty</a><a href={url('mapa/')}>Mapa wymagań</a><a href={url('druk/')}>Cały podręcznik do druku</a></div></div></details><p class="sidebar-note">JBD-320<br/>Przekaźniki · TTL · LOGO 230 RC</p></aside>
<main id="tresc" tabindex="-1"><slot/></main>
</div>
<footer>SMATR · materiały do nauki <span>Źródła: instrukcje laboratoriów 1–3 · <a href={url('zrodla/')}>Sprawdź korekty</a></span></footer>
<dialog id="diagram-dialog" aria-label="Powiększony schemat"><div class="controls"><button id="close-diagram">Zamknij schemat</button><label>Powiększenie<select id="diagram-scale"><option value="100">100%</option><option value="150">150%</option><option value="200">200%</option></select></label></div><div class="zoom-scroll"><div id="zoom-content"></div></div></dialog>
<script>
  import {namespaceIds} from '../lib/print';
  const toc = document.querySelector<HTMLDetailsElement>('.toc');
  const media = window.matchMedia('(max-width: 900px)');
  const update = () => { if (toc) toc.open = !media.matches; };
  update(); media.addEventListener('change', update);
  const dialog=document.querySelector<HTMLDialogElement>('#diagram-dialog');
  const zoom=document.querySelector<HTMLElement>('#zoom-content');
  document.querySelectorAll<HTMLElement>('.diagram').forEach((figure,index)=>{
    const svg=figure.querySelector('svg');if(!svg||!dialog||!zoom)return;
    const button=document.createElement('button');button.textContent='Powiększ schemat';button.className='zoom-action';button.setAttribute('aria-haspopup','dialog');button.setAttribute('aria-label',`Powiększ schemat ${index+1}`);
    button.addEventListener('click',()=>{zoom.innerHTML=namespaceIds(svg.outerHTML,'zoom');zoom.style.width='100%';const scale=document.querySelector<HTMLSelectElement>('#diagram-scale');if(scale)scale.value='100';dialog.showModal();});figure.append(button);
  });
  document.getElementById('close-diagram')?.addEventListener('click',()=>dialog?.close());
  document.querySelector<HTMLSelectElement>('#diagram-scale')?.addEventListener('change',event=>{if(zoom)zoom.style.width=`${(event.target as HTMLSelectElement).value}%`;});
  const details=Array.from(document.querySelectorAll<HTMLDetailsElement>('.exercise details'));let original:boolean[]=[];
  window.addEventListener('beforeprint',()=>{original=details.map(d=>d.open);details.forEach(d=>d.open=true);});
  window.addEventListener('afterprint',()=>details.forEach((d,i)=>d.open=original[i]??false));
</script>
</body></html>
